# Copy to frontend/.env and fill in.
# Expo inlines EXPO_PUBLIC_* into the JS bundle at build time, so this value is
# readable by anyone who unpacks the app. Use a free-tier key, and proxy it
# through the backend if it ever needs to be genuinely secret.
# Get a key at https://openweathermap.org/api
EXPO_PUBLIC_OPENWEATHER_API_KEY=
